datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String              @id @default(uuid())
  email       String              @unique
  password    String
  name        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  projects    Project[]           // Sahib olduğu projeler
  memberships ProjectMembership[] // Rol içeren proje üyelikleri
  assignedTasks Task[]            @relation("AssignedTasks")
  createdTasks  Task[]            @relation("CreatedTasks")
  taskCollaborators TaskCollaborator[]
  comments      Comment[]
  portfolios    Portfolio[]       @relation("OwnedPortfolios")
  starredProjects StarredProject[] @relation("StarredProjects")
  starredPortfolios StarredPortfolio[] @relation("StarredPortfolios")
  
  notifications Notification[]    @relation("UserNotifications")
  actorNotifications Notification[] @relation("ActorNotifications")
  ownedGoals    Goal[]            @relation("OwnedGoals")
  uploadedAttachments Attachment[] @relation("UploadedAttachments")
  workspaceMembers WorkspaceMember[]
  teamMembers      TeamMember[]
  
  projectMessages  ProjectMessage[]
  projectMessageReplies ProjectMessageReply[]
  
  commentReactions CommentReaction[]
  activities    TaskActivity[]
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())

  members     WorkspaceMember[]
  teams       Team[]
  projects    Project[]
  portfolios  Portfolio[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  members     TeamMember[]
  projects    Project[]
}

model TeamMember {
  id          String   @id @default(uuid())
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Project {
  id          String              @id @default(uuid())
  name        String
  description String?
  status      String              @default("NONE")
  isArchived  Boolean             @default(false)
  isTemplate  Boolean             @default(false)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  color       String?             @default("#4F46E5")
  icon        String?             @default("📋")

  ownerId     String
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  workspaceId String?
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  teamId      String?
  team        Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)

  sections    Section[]
  secondaryTasks TaskProject[]
  members     ProjectMembership[] // ← DEĞİŞEN SATIR: Rol içeren proje üyeleri
  rules       Rule[]              // Kural motoru için
  portfolios  PortfolioProject[]
  
  projectMessages ProjectMessage[]

  defaultView String              @default("List")
  activeViews Json?               @default("[\"Overview\", \"List\", \"Board\", \"Timeline\", \"Gantt\", \"Dashboard\", \"Calendar\", \"Workload\", \"Forms\"]")
  
  customFieldSettings Json?       @default("[]")
  priorityFieldSettings Json?
  formSettings        Json?
  notifications Notification[]
  goals         GoalProject[]
  starredBy     StarredProject[] @relation("ProjectStars")
}

// --- YENİ MODEL: ROL DESTEKLİ ÜYELİK TABLOSU ---
model ProjectMembership {
  id        String   @id @default(uuid())
  role      String   @default("EDITOR") // "EDITOR", "COMMENTER", "VIEWER"
  createdAt DateTime @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // Bir kullanıcı bir projeye sadece 1 kere üye olabilir
}

model Section {
  id        String   @id @default(uuid())
  name      String   
  order     Int      
  createdAt DateTime @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  secondaryTasks TaskProject[] @relation("SecondaryTasks")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  priority    String    @default("MEDIUM") 
  type        String    @default("TASK") // "TASK", "MILESTONE", "APPROVAL" vb.
  approvalStatus String? @default("PENDING") // "PENDING", "APPROVED", "CHANGES_REQUESTED", "REJECTED"
  order       Int       
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  likes       Int       @default(0)
  customFields Json?    @default("{}") // (Sınırsız esnek alan için)
  githubPRs    Json?    @default("[]")
  
  sectionId   String
  section     Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creatorId   String
  creator     User      @relation("CreatedTasks", fields: [creatorId], references: [id])
  
  parentId    String?
  parent      Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]    @relation("Subtasks")

  blockedBy   TaskDependency[] @relation("BlockedBy")
  blocking    TaskDependency[] @relation("Blocking")
  collaborators TaskCollaborator[]
  comments    Comment[]
  notifications Notification[]
  tags        Tag[]            @relation("TaskTags")
  attachments Attachment[]
  activities  TaskActivity[]
  secondaryProjects TaskProject[]

  reminderSent1Week   Boolean @default(false)
  reminderSent1Day    Boolean @default(false)
  reminderSent1Hour   Boolean @default(false)
  reminderSentOverdue Boolean @default(false)

  isRecurring          Boolean   @default(false)
  recurrenceRule       String?   // 'DAILY', 'WEEKLY', 'MONTHLY', 'YEARLY', 'CUSTOM'
  recurrenceCustom     Json?     // { frequency, interval, days }
  nextRecurrenceTaskId String?
}

// --- YENİ MODEL: TAGS ---
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#9CA3AF") // Varsayılan renk
  createdAt DateTime @default(now())

  tasks     Task[]   @relation("TaskTags")
}

// --- YENİ MODEL: MULTI-HOMING (Task in Multiple Projects) ---
model TaskProject {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation("SecondaryTasks", fields: [sectionId], references: [id], onDelete: Cascade)
  order     Int
  createdAt DateTime @default(now())

  @@unique([taskId, projectId])
}

model TaskDependency {
  id           String @id @default(uuid())
  blockingId   String 
  blockedById  String 
  blockingTask Task   @relation("Blocking", fields: [blockingId], references: [id], onDelete: Cascade)
  blockedByTask Task  @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([blockingId, blockedById])
}

// --- YENİ MODEL: KURAL MOTORU ---
model Rule {
  id           String   @id @default(uuid())
  triggerType  String
  triggerValue String?
  actionType   String
  actionValue  String?
  createdAt    DateTime @default(now())

  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// --- YENİ MODEL: YORUMLAR ---
model Comment {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
  
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  reactions CommentReaction[]
}

// --- YENİ MODEL: GÖREV AKTİVİTELERİ (ACTIVITY FEED) ---
model TaskActivity {
  id        String   @id @default(uuid())
  action    String   // e.g. "changed the due date", "moved this task to Done"
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- YENİ MODEL: GÖREV ORTAK ÇALIŞANLARI ---
model TaskCollaborator {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// --- YENİ MODEL: PORTFOLIOS ---
model Portfolio {
  id          String   @id @default(uuid())
  name        String
  privacy     String   @default("Public to My workspace")
  defaultView String   @default("List")
  status      String   @default("On track") // e.g., On track, At risk, Off track
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String
  owner       User     @relation("OwnedPortfolios", fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    PortfolioProject[]
  
  childPortfolios   PortfolioPortfolio[] @relation("ParentPortfolios")
  parentPortfolios  PortfolioPortfolio[] @relation("ChildPortfolios")
  starredBy         StarredPortfolio[]   @relation("PortfolioStars")
}

model PortfolioProject {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, projectId])
}

model PortfolioPortfolio {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())

  parentPortfolioId String
  parentPortfolio   Portfolio @relation("ParentPortfolios", fields: [parentPortfolioId], references: [id], onDelete: Cascade)

  childPortfolioId  String
  childPortfolio    Portfolio @relation("ChildPortfolios", fields: [childPortfolioId], references: [id], onDelete: Cascade)

  @@unique([parentPortfolioId, childPortfolioId])
}

// --- YENİ MODEL: PROJECT MESSAGES ---
model ProjectMessage {
  id        String   @id @default(uuid())
  subject   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  replies   ProjectMessageReply[]
}

model ProjectMessageReply {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())

  messageId String
  message   ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- YENİ MODEL: BİLDİRİMLER (NOTIFICATIONS) ---
model Notification {
  id        String   @id @default(uuid())
  type      String   // "ASSIGNED", "COMMENTED", "COMPLETED", "MENTIONED" vb.
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  userId    String   
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  actorId   String?  
  actor     User?    @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// --- YENİ MODEL: GOALS (HEDEFLER) ---
model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("On track") // On track, At risk, Off track
  timePeriod  String?  // e.g., Q3 2026, H2 2026
  level       String   @default("Company")  // Company, Team
  
  metricType  String   @default("Percentage") // Percentage, Numeric, Currency
  currentValue Float   @default(0)
  targetValue  Float   @default(100)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String
  owner       User     @relation("OwnedGoals", fields: [ownerId], references: [id], onDelete: Cascade)
  
  projects    GoalProject[]
}

model GoalProject {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([goalId, projectId])
}

model CommentReaction {
  id        String   @id @default(uuid())
  emoji     String
  createdAt DateTime @default(now())

  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
}

// --- YENİ MODEL: YILDIZLANMIŞ PROJELER ---
model StarredProject {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation("StarredProjects", fields: [userId], references: [id], onDelete: Cascade)
  
  projectId String
  project   Project  @relation("ProjectStars", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// --- YENİ MODEL: YILDIZLANMIŞ PORTFOLIOS ---
model StarredPortfolio {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation("StarredPortfolios", fields: [userId], references: [id], onDelete: Cascade)
  
  portfolioId String
  portfolio   Portfolio @relation("PortfolioStars", fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([userId, portfolioId])
}

// --- YENİ MODEL: DOSYA EKLERİ (ATTACHMENTS) ---
model Attachment {
  id           String   @id @default(uuid())
  filename     String   // UUID-based filename on disk
  originalName String   // Original name the user uploaded
  mimeType     String
  size         Int      // File size in bytes
  createdAt    DateTime @default(now())

  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User     @relation("UploadedAttachments", fields: [uploaderId], references: [id], onDelete: Cascade)
}