{
  "name": "asana-backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "npx prisma db push --accept-data-loss && npx prisma generate && node src/server.js",
    "test": "export DATABASE_URL=postgresql://asana_user:asana_password@postgres_db:5432/asana_test_db && npx prisma db push --accept-data-loss && jest --runInBand --detectOpenHandles",
    "test:watch": "export DATABASE_URL=postgresql://asana_user:asana_password@postgres_db:5432/asana_test_db && jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.10.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "xss": "^1.0.15",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "@sentry/node": "^7.100.0",
    "@sentry/profiling-node": "^1.3.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0"
  }
}
